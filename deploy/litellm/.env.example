COMPOSE_PROJECT_NAME=moss-litellm
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
POSTGRES_IMAGE=postgres:16-alpine
DATA_DIR=/data/litellm
LITELLM_BIND_IP=0.0.0.0
LITELLM_PORT=4000
LITELLM_PUBLIC_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=change-me
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
MOSS_INTEGRATION_NETWORK=moss-integrations

# Configure at least one upstream in config/litellm.yaml or through env.
UPSTREAM_API_KEY=
UPSTREAM_API_BASE=https://api.openai.com/v1
UPSTREAM_MODEL=gpt-4o-mini
