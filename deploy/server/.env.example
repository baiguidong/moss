COMPOSE_PROJECT_NAME=moss-server
MOSS_REGISTRY=ghcr.io
MOSS_REGISTRY_USERNAME=
MOSS_SERVER_IMAGE=ghcr.io/baiguidong/moss-server:latest
MOSS_RUNTIME_IMAGE=ghcr.io/baiguidong/moss-runtime:latest
# Optional single-user WebUI; existing Server session features remain available.
MOSS_WEB_ENABLED=0
MOSS_WEB_IMAGE=ghcr.io/baiguidong/moss-webui:latest
MOSS_WEB_HTTPS_PORT=8444
MOSS_WEB_ORIGIN=
# Empty on first enable: pin to the configured bootstrap administrator via auth/me.
MOSS_WEB_OWNER_ID=
MOSS_WEB_OWNER_ORG_ID=
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:alpine
MOSS_INTEGRATION_NETWORK=moss-integrations

MOSS_SERVER_HOME=/data/moss-server
MOSS_PUBLIC_HOST=auto
MOSS_HTTPS_PORT=443
MOSS_ADMIN_USERNAME=admin
MOSS_ADMIN_PASSWORD=password
TZ=Asia/Shanghai

# Private MySQL for this Compose stack. Keep these values stable after initialization.
MYSQL_IMAGE=mysql:8.4.8
MOSS_DB_NAME=moss
MOSS_DB_USER=moss
MOSS_DB_PASSWORD=moss_internal_password
MOSS_DB_ROOT_PASSWORD=moss_root_internal_password

# Silo is private to the storage network. Its version is independent of Moss.
MINIO_IMAGE=docker.1ms.run/pgsty/silo:RELEASE.2026-08-06T00-00-00Z
SILO_MC_IMAGE=docker.1ms.run/pgsty/silo:RELEASE.2026-08-06T00-00-00Z
SILO_ROOT_USER=moss-admin
SILO_ROOT_PASSWORD=
