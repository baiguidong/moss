# Keep this name stable across release directories to reuse the same HOME volume.
# For an existing deployment, use its original Compose project name instead.
COMPOSE_PROJECT_NAME=moss-webui
MOSS_WEB_IMAGE=moss-webui:local
MOSS_WEB_BIND=127.0.0.1
MOSS_WEB_PUBLISHED_PORT=43128
MOSS_WEB_ORIGIN=http://localhost:43128

# Optional Moss Server authentication. New managed installs resolve the owner at login.
# OWNER_ID/OWNER_ORG_ID below apply only to legacy compose.yaml deployments.
MOSS_WEB_AUTH_SERVER=
MOSS_WEB_OWNER_ID=
MOSS_WEB_OWNER_ORG_ID=
