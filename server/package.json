{
  "name": "@moss/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd .. && bun run scripts/build.js --target=server",
    "check": "bun run typecheck && bun build src/serverCli.ts src/sessionRunnerCli.ts --target=node --format=esm --outdir=/tmp/moss-server-check",
    "test": "bun test src",
    "test:mysql": "node scripts/test-mysql.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@smithy/node-http-handler": "^4.12.1",
    "mysql2": "^3.24.4",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.20.0",
    "zod": "*"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
