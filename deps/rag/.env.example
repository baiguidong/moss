COMPOSE_PROJECT_NAME=ragflow

# Public runtime images. Override these with an internal registry when needed.
RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.27.1
INFINITY_IMAGE=docker.1ms.run/infiniflow/infinity:v0.7.3-x64-v3
MYSQL_IMAGE=docker.1ms.run/library/mysql:8.0.40
MINIO_IMAGE=docker.1ms.run/pgsty/silo:RELEASE.2026-08-06T00-00-00Z
REDIS_IMAGE=docker.1ms.run/valkey/valkey:8
OLLAMA_IMAGE=docker.m.daocloud.io/ollama/ollama:0.33.3
EXTENDED_MCP_IMAGE=moss/ragflow-mcp-extended:0.1.0
EXTENDED_MCP_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm

# Deployment mode.
RAGFLOW_DEVICE=cpu
WITH_LOCAL_MODELS=1
ENABLE_NATIVE_MCP=1
ENABLE_EXTENDED_MCP=1
ENABLE_MOSS_RAG_MCP=1
RAGFLOW_BIND_IP=0.0.0.0
RAGFLOW_MCP_BIND_IP=auto
SVR_WEB_HTTP_PORT=80
SVR_MCP_PORT=9382
EXTENDED_MCP_PORT=9385
MOSS_RAG_MCP_PORT=9386
EXTENDED_MCP_PUBLIC_URL=
MOSS_RAG_MCP_PUBLIC_URL=
# Per-host external configuration. Use a URL reachable from the MCP container.
MOSS_RAG_MCP_MOSS_SERVER_URL=http://host.docker.internal:43127
MOSS_RAGFLOW_GATEWAY_TOKEN=CHANGE_ME
EXTENDED_MCP_SCOPES=read,write,agent
EXTENDED_MCP_MAX_BASE64_MB=8
EXTENDED_MCP_MAX_UPLOAD_MB=200

# Local Ollama defaults. Models are downloaded only when WITH_LOCAL_MODELS=1.
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Internal service configuration.
DOC_ENGINE=infinity
DB_TYPE=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DBNAME=rag_flow
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_MAX_PACKET=1073741824
MINIO_HOST=minio
MINIO_USER=rag_flow
MINIO_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
RAGFLOW_ADMIN_EMAIL=admin@ragflow.io
RAGFLOW_ADMIN_NICKNAME=admin
ADMIN_DEFAULT_PASSWORD=CHANGE_ME
RAGFLOW_ADMIN_BIND_IP=127.0.0.1
ADMIN_SVR_HTTP_PORT=9381
REGISTER_ENABLED=1
ENABLE_REGISTER=1
API_PROXY_SCHEME=python
DOC_BULK_SIZE=1
EMBEDDING_BATCH_SIZE=4
THREAD_POOL_MAX_WORKERS=16
MEM_LIMIT=2147483648
RAGFLOW_MEM_LIMIT=4g
INFINITY_MEM_LIMIT=4g
MYSQL_MEM_LIMIT=1g
MINIO_MEM_LIMIT=768m
REDIS_MEM_LIMIT=256m
TZ=Asia/Shanghai
HF_ENDPOINT=
