{
  "name": "moss-desktop",
  "version": "0.0.3",
  "description": "Moss - AI coding agent desktop client",
  "author": "Moss AI Team",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:direct": "node scripts/build-direct.mjs",
    "build:renderer": "vite build && mkdir -p dist/renderer/build && cp -r build/* dist/renderer/build/",
    "runtimes:download": "node scripts/download-runtimes.mjs",
    "runtimes:download:all": "node scripts/download-runtimes.mjs --all",
    "start": "node scripts/build-direct.mjs && vite build && electron .",
    "dev": "node scripts/dev.mjs start",
    "dev:renderer": "vite",
    "check": "node --check src/main.mjs && node --check src/preload.mjs && node --check scripts/dev.mjs && node --check scripts/build-direct.mjs && node --check scripts/download-runtimes.mjs && tsc --noEmit",
    "dist:win": "node scripts/download-runtimes.mjs --target=win32-x64 && node scripts/build-direct.mjs && vite build && electron-builder --win --publish never",
    "dist:mac": "node scripts/download-runtimes.mjs && node scripts/build-direct.mjs && vite build && electron-builder --mac --publish never",
    "release:win": "node scripts/download-runtimes.mjs --target=win32-x64 && node scripts/build-direct.mjs && vite build && electron-builder --win --publish always",
    "release:mac": "node scripts/download-runtimes.mjs && node scripts/build-direct.mjs && vite build && electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.moss.ai",
    "productName": "Moss",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "icon": "build/icon",
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "dmg": {
      "background": null,
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "vendor/ripgrep/**/*",
      "index.html",
      "package.json",
      "electron-direct.mjs"
    ],
    "extraResources": [
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../assistants",
        "to": "assistants",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../apps",
        "to": "apps",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/build/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "resources/runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "sudoprivacy",
      "repo": "moss"
    }
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@fontsource-variable/material-symbols-outlined": "^5.2.42",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "@xmldom/xmldom": "^0.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "js-yaml": "^5.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.10",
    "remark-gfm": "^4.0.0",
    "semver": "^7.7.4",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "1.3.3",
    "wavesurfer.js": "^7.12.7",
    "xlsx-republish": "^0.20.3",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "40.8.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
