{
  "name": "moss-desktop",
  "version": "2.1.88",
  "description": "Moss - AI coding agent desktop client",
  "author": "Moss AI Team",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:direct": "node scripts/build-direct.mjs",
    "build:adapters": "node scripts/build-adapters.mjs",
    "build:renderer": "vite build && node scripts/copy-build-resources.mjs",
    "runtimes:download": "node scripts/download-runtimes.mjs",
    "runtimes:download:all": "node scripts/download-runtimes.mjs --all",
    "start": "node scripts/build-direct.mjs && node scripts/build-adapters.mjs && vite build && electron .",
    "dev": "node scripts/dev.mjs start",
    "dev:renderer": "vite",
    "check": "node --check src/main.mjs && node --check src/preload.mjs && node --check src/adapter-settings.mjs && node --check src/adapter-process-manager.mjs && node --check src/desktop-settings.mjs && node --check src/desktop-mcp-settings.mjs && node --check src/remote-direct-client.mjs && node --check src/remote-session-reconcile.mjs && node --check src/remote-direct-oauth.mjs && node --check src/remote-direct-auth-window.mjs && node --check src/moss-cron-scheduler.mjs && node --check src/file-system-ipc.mjs && node --check src/update-capabilities.mjs && node --check src/runtime/runtime-manifest.mjs && node --check scripts/dev.mjs && node --check scripts/build-direct.mjs && node --check scripts/build-adapters.mjs && node --check scripts/clean-installers.mjs && node --check scripts/copy-build-resources.mjs && node --check scripts/download-runtimes.mjs && node --check scripts/after-pack.mjs && node --check scripts/verify-package.mjs && tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "dist:win": "node scripts/clean-installers.mjs && node scripts/download-runtimes.mjs --target=win32-x64 && node scripts/build-direct.mjs && node scripts/build-adapters.mjs && bun run build:renderer && electron-builder --win --x64 --publish never && node scripts/verify-package.mjs --platform=win32 --arch=x64",
    "dist:mac": "node scripts/clean-installers.mjs && node scripts/download-runtimes.mjs --target=darwin-arm64 && node scripts/build-direct.mjs && node scripts/build-adapters.mjs && bun run build:renderer && electron-builder --mac --arm64 --publish never && node scripts/verify-package.mjs --platform=darwin --arch=arm64",
    "release:win": "node scripts/clean-installers.mjs && node scripts/download-runtimes.mjs --target=win32-x64 && node scripts/build-direct.mjs && node scripts/build-adapters.mjs && bun run build:renderer && electron-builder --win --x64 --publish never && node scripts/verify-package.mjs --platform=win32 --arch=x64",
    "release:mac": "node scripts/clean-installers.mjs && node scripts/download-runtimes.mjs --target=darwin-arm64 && node scripts/build-direct.mjs && node scripts/build-adapters.mjs && bun run build:renderer && electron-builder --mac --arm64 --publish never && node scripts/verify-package.mjs --platform=darwin --arch=arm64"
  },
  "build": {
    "appId": "com.moss.ai",
    "productName": "Moss",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.mjs",
    "icon": "build/icon",
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "dmg": {
      "sign": false,
      "background": null,
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "security/**/*.mjs"
        ]
      },
      {
        "from": "../packages/app-sdk",
        "to": "packages/app-sdk",
        "filter": ["package.json", "src/**/*"]
      },
      {
        "from": "../packages/app-runtime",
        "to": "packages/app-runtime",
        "filter": ["package.json", "src/**/*"]
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "ajv/**/*",
          "fast-deep-equal/**/*",
          "fast-uri/**/*",
          "json-schema-traverse/**/*",
          "require-from-string/**/*",
          "semver/**/*",
          "sharp/**/*",
          "detect-libc/**/*",
          "@img/**/*"
        ]
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../assistants",
        "to": "assistants",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../apps",
        "to": "apps",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/build/**",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "resources/connectors",
        "to": "connectors",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/runtimes",
        "to": "runtimes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../vendor/ripgrep",
        "to": "ripgrep",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/adapters",
        "to": "adapters",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "notarize": false
    },
    "win": {
      "cscLink": "",
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "baiguidong",
      "repo": "moss"
    }
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@fontsource-variable/material-symbols-outlined": "^5.2.42",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "@xmldom/xmldom": "^0.9.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "js-yaml": "^5.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.564.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-json-view-lite": "^2.5.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.10",
    "remark-gfm": "^4.0.0",
    "semver": "^7.7.4",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.4",
    "tw-animate-css": "1.3.3",
    "xlsx-republish": "^0.20.3",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "40.8.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
