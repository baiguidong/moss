{
  "name": "claude-code-electron-mvp",
  "version": "0.2.0",
  "description": "Moss - AI coding agent desktop client",
  "author": "Moss AI Team",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:renderer": "vite build",
    "start": "vite build && electron .",
    "dev": "node scripts/dev.mjs start",
    "dev:renderer": "vite",
    "check": "node --check src/main.mjs && node --check src/preload.mjs && node --check src/app-preload.mjs && node --check scripts/dev.mjs && tsc --noEmit",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.moss.ai",
    "productName": "Moss",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "../electron-direct.mjs",
      "../cli-node.js"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "1.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "40.8.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
