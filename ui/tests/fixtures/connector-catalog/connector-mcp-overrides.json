{
  "version": 1,
  "connectors": {
    "qq-mail": {
      "servers": {
        "qq-mail": {
          "oauth": {
            "clientName": "WorkBuddy"
          }
        }
      }
    },
    "mx-ds-mcp": {
      "servers": {
        "mx-ds-mcp": {
          "oauth": {
            "clientName": "WorkBuddy"
          }
        }
      }
    },
    "tencent-health-nges": {
      "servers": {
        "nges": {
          "oauth": {
            "clientName": "WorkBuddy"
          }
        }
      }
    },
    "xingtu-claw-risk": {
      "servers": {
        "xingtu-claw-risk": {
          "oauth": {
            "redirectUri": "moss://moss/mcp/xingtu-claw-risk/oauth/callback"
          }
        }
      }
    },
    "finenter": {
      "servers": {
        "mcp-server-brm": {
          "oauth": {
            "resourceMetadataUrl": "https://server.comein.cn/.well-known/oauth-protected-resource/mcp-server-brm"
          }
        }
      }
    },
    "fyopen-lawsearch": {
      "servers": {
        "fy-law-search-service": {
          "oauth": {
            "authServerMetadataUrl": "https://fyopen.com/.well-known/oauth-authorization-server/apis/cop-oauth2",
            "authorizationServerOrigin": "https://fyopen.com"
          }
        }
      }
    },
    "pkulaw": {
      "servers": {
        "pkulaw": {
          "oauth": {
            "omitRegistrationScope": true
          }
        }
      }
    },
    "kling-ai-plugin": {
      "servers": {
        "kling-ai-plugin": {
          "oauth": {
            "clientName": "Plugin-WorkBuddy"
          }
        }
      }
    },
    "kling-ai-plugin-ai": {
      "servers": {
        "kling-ai-plugin": {
          "oauth": {
            "clientName": "Plugin-WorkBuddy"
          }
        }
      }
    }
  }
}
