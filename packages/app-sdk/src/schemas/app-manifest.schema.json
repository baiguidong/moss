{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moss.local/schemas/app-manifest-v2.json",
  "title": "Moss App Manifest V2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "hostApi",
    "permissions"
  ],
  "anyOf": [
    {
      "required": [
        "ui"
      ]
    },
    {
      "required": [
        "backend"
      ]
    },
    {
      "required": [
        "connectorApp"
      ]
    }
  ],
  "properties": {
    "mcpApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "string",
          "minLength": 1
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "examples": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "usage": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "session",
                "stateless"
              ]
            },
            "idleTimeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            }
          }
        }
      }
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
    },
    "version": {
      "type": "string"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "overview": {
      "type": "object",
      "description": "Optional display-only content for the Core App information page. Older hosts may ignore it.",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "examples": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "toolLoading": {
      "enum": [
        "always",
        "on-demand"
      ],
      "description": "Whether available App tools are included in the model's initial tool set. Availability and permissions still apply."
    },
    "category": {
      "type": "string",
      "description": "One primary category for App discovery. Omitted legacy values are displayed as other.",
      "default": "other",
      "oneOf": [
        {
          "const": "communication",
          "title": "沟通协作"
        },
        {
          "const": "knowledge",
          "title": "文档与知识"
        },
        {
          "const": "files",
          "title": "文件与存储"
        },
        {
          "const": "creative",
          "title": "设计与音视频"
        },
        {
          "const": "development",
          "title": "开发工具"
        },
        {
          "const": "data",
          "title": "数据与分析"
        },
        {
          "const": "automation",
          "title": "自动化"
        },
        {
          "const": "ai",
          "title": "AI 与智能体"
        },
        {
          "const": "sales",
          "title": "销售与客户"
        },
        {
          "const": "marketing",
          "title": "营销与电商"
        },
        {
          "const": "finance",
          "title": "金融与投研"
        },
        {
          "const": "business",
          "title": "经营与财税"
        },
        {
          "const": "hr",
          "title": "人事与招聘"
        },
        {
          "const": "education",
          "title": "教育与文化"
        },
        {
          "const": "legal",
          "title": "法律与风控"
        },
        {
          "const": "life",
          "title": "出行与生活"
        },
        {
          "const": "diagnostics",
          "title": "诊断与安全"
        },
        {
          "const": "other",
          "title": "其他"
        }
      ]
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location"
      ],
      "description": "Primary App entry: more for a workspace, details for Core details with declared settings, settings for legacy settings pages, none for background Apps. Details requires Host API >=3.22.0.",
      "properties": {
        "location": {
          "enum": [
            "more",
            "settings",
            "none",
            "details"
          ]
        },
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "\\S"
      }
    },
    "icon": {
      "type": "string"
    },
    "hostApi": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9:._-]*$"
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "route": {
                "type": "string",
                "pattern": "^#/",
                "maxLength": 256
              },
              "icon": {
                "type": "string",
                "maxLength": 80
              },
              "order": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "viewId": {
                "type": "string",
                "maxLength": 80
              },
              "group": {
                "type": "string",
                "description": "Settings destination; required for Apps declaring navigation. Legacy contributions without a group appear under apps. Requires Host API >=3.4.0.",
                "enum": [
                  "integrations",
                  "tools",
                  "apps"
                ]
              },
              "order": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "form": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "readAction",
                  "saveAction"
                ],
                "properties": {
                  "readAction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "saveAction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              "presentation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "enum": [
                      "default",
                      "wide"
                    ]
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "viewId"
                ],
                "not": {
                  "required": [
                    "form"
                  ]
                }
              },
              {
                "required": [
                  "form"
                ],
                "not": {
                  "required": [
                    "viewId"
                  ]
                }
              }
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "title",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "maxLength": 1000
              },
              "listAction": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "maxLength": 128
              },
              "inputSchema": {
                "type": "string"
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "title",
              "description",
              "inputSchema",
              "effect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "action": {
                "type": "string",
                "maxLength": 128
              },
              "inputSchema": {
                "type": "string"
              },
              "outputSchema": {
                "type": "string"
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "effect": {
                "enum": [
                  "read",
                  "write",
                  "destructive"
                ]
              },
              "execution": {
                "enum": [
                  "backend",
                  "native",
                  "host"
                ]
              },
              "host": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "protocol",
                  "method"
                ],
                "properties": {
                  "protocol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "serviceId": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "resourceProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "schemes",
              "resolveAction"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "schemes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9+.-]{1,31}$"
                }
              },
              "resolveAction": {
                "type": "string",
                "maxLength": 128
              },
              "listAction": {
                "type": "string",
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "authoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "intents"
                ],
                "properties": {
                  "target": {
                    "const": "moss-app"
                  },
                  "intents": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "create",
                        "edit"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "title",
              "viewId",
              "placement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "viewId": {
                "type": "string",
                "maxLength": 80
              },
              "placement": {
                "enum": [
                  "overlay",
                  "status"
                ]
              },
              "permission": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "services": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description",
              "path",
              "cli"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "cli": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 2160
            },
            "resizable": {
              "type": "boolean"
            }
          }
        },
        "builtin": {
          "const": "mcp",
          "description": "Core-provided settings UI for configuration-only MCP Apps. Requires Host API >=3.9.0."
        }
      },
      "oneOf": [
        {
          "required": [
            "entry"
          ],
          "not": {
            "required": [
              "builtin"
            ]
          }
        },
        {
          "required": [
            "builtin"
          ],
          "not": {
            "required": [
              "entry"
            ]
          }
        }
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "entry",
        "runtime",
        "apiVersion",
        "lifecycle",
        "actions"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "const": "node"
        },
        "apiVersion": {
          "const": 1
        },
        "storage": { "enum": ["app", "session"] },
        "lifecycle": {
          "enum": [
            "on-demand",
            "persistent"
          ]
        },
        "instanceMode": {
          "const": "single",
          "description": "Legacy field; each App has one Backend and new manifests omit this field."
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "inputSchema": {
                "type": "string"
              },
              "outputSchema": {
                "type": "string"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 300000
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string"
            },
            "secrets": {
              "type": "string"
            }
          }
        }
      }
    },
    "appCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provides": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "methods"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,94}[a-z0-9])?/v[1-9][0-9]*$"
              },
              "methods": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "action",
                    "permission",
                    "effect"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                    },
                    "action": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                    },
                    "permission": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9:._-]*$"
                    },
                    "effect": {
                      "const": "read"
                    },
                    "resourceReadMethod": {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                    }
                  }
                }
              }
            }
          }
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,94}[a-z0-9])?/v[1-9][0-9]*$"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        },
        "usesTools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appId",
              "tools"
            ],
            "properties": {
              "appId": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,78}[a-z0-9])?$"
              },
              "tools": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f*?]+$"
                }
              }
            }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols"
      ],
      "properties": {
        "protocols": {
          "description": "Host protocols used by this App UI and Backend.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,94}[a-z0-9])?/v[1-9][0-9]*$"
          }
        }
      }
    },
    "toolScope": {
      "type": "string",
      "enum": [
        "global",
        "session"
      ],
      "default": "session",
      "description": "App-wide tool visibility. All native and MCP tools inherit this scope; session requires explicit conversation selection."
    },
    "nativeAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiVersion",
        "entry"
      ],
      "properties": {
        "kind": {
          "const": "desktop-control"
        },
        "apiVersion": {
          "const": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin-arm64",
          "darwin-x64",
          "win32-x64",
          "win32-arm64",
          "linux-x64",
          "linux-arm64"
        ]
      }
    },
    "toolSelection": {
      "enum": [
        "app",
        "services"
      ],
      "description": "App or independently selectable subservices. Requires Host API >=3.8.0; defaults to app."
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group"
      ],
      "properties": {
        "kind": {
          "enum": [
            "app",
            "tool"
